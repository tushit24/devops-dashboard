# ==============================================================================
# Kubernetes Secret Template Example
# ==============================================================================
# Copy this file to k8s/secret.yaml (which is ignored by .gitignore) and
# replace the placeholders with base64-encoded values of your actual secrets.
#
# To generate base64-encoded strings:
#   Bash/Linux/macOS:
#     echo -n "your_secret_value" | base64
#
#   PowerShell (Windows):
#     [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your_secret_value"))
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: devops-secrets
  labels:
    app: devops-dashboard
type: Opaque
data:
  # Base64 encoded PostgreSQL password
  POSTGRES_PASSWORD: <base64-encoded-postgres-password>

  # Base64 encoded AWS Credentials for DynamoDB access
  AWS_ACCESS_KEY_ID: <base64-encoded-aws-access-key-id>
  AWS_SECRET_ACCESS_KEY: <base64-encoded-aws-secret-access-key>
